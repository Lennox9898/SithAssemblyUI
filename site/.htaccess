# Shared by IONOS Deploy Now and Linux/Apache web hosting.
# Deploy the CONTENTS of dist/ as the document root, including this file.
DirectoryIndex index.html
Options -Indexes -MultiViews
AddDefaultCharset UTF-8
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  # This deployment only serves files; it has no form or API endpoints.
  RewriteCond %{REQUEST_METHOD} !^(GET|HEAD)$
  RewriteRule ^ - [R=405,L]
  # Keep ACME certificate challenges accessible; hide other dot paths.
  RewriteRule (^|/)\.(?!well-known(?:/|$)) - [R=404,L]
</IfModule>

<FilesMatch "(?i)(?:^\.|~$|\.(?:bak|old|orig|save|sql|sqlite3?|db|env|ini|log|pem|key|p12|pfx|zip|tar|gz|tgz|7z|ps1|cmd|bat|sh|php[0-9]?|phtml|phar)$)">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Content-Security-Policy "default-src 'none'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'none'; connect-src 'none'; img-src 'self'; font-src 'self'; style-src 'self'; script-src 'self'; manifest-src 'self'"
  # Applies only to this hostname; subdomains keep their own TLS policy.
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set Allow "GET, HEAD" "expr=%{REQUEST_METHOD} !~ m#^(GET|HEAD)$#"
  # Unversioned assets must be revalidated after a new upload.
  Header always set Cache-Control "no-cache"
  Header always set Cache-Control "no-store" "expr=%{REQUEST_URI} =~ m#^/login(?:/|$)#"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript image/svg+xml
</IfModule>

# Deploy Now already enforces HTTPS, including preview URLs.
# For normal hosting, activate SSL and then follow docs/WEBHOSTING.md.
